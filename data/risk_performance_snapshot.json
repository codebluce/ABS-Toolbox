c-label\">静态池逾期率</span><span class=\"value\">${fmt(r.overdue)}</span><span class=\"quality-change\">${qualityDelta(r,'overdue')}</span></div><div class=\"metric-row\"><span class=\"metric-label\">静态池不良率</span><span class=\"value\">${fmt(r.bad)}</span><span class=\"quality-change\">${qualityDelta(r,'bad')}</span></div><div class=\"metric-row\"><span class=\"metric-label\">年化不良率</span><span class=\"value\">${fmt(r.annualBad)}</span><span class=\"quality-change\">${qualityDelta(r,'annualBad')}</span></div></div></section>`).join('');if(!period.records.some(r=>qualityMatch(r.name)))$('cards').innerHTML='<div class=\"quality-empty\" style=\"padding:20px;background:white;border:1px solid #e1e8ef;border-radius:8px;grid-column:1/-1;\">该时点没有此资产的对外披露数据。</div>';$('rules').innerHTML=period.records.filter(r=>qualityMatch(r.name)).map(r=>`<div class=\"rule-item\"><b>${r.name}</b>${esc(r.overdueRule)}<br>${esc(r.badRule)}<br>久期／年化周转次数：${esc(r.turnover)}<br>原表补充表述：${esc(r.disclosureRange)}</div>`).join('');for(const key of ['overdue','bad'])draw(key);}\nfunction draw(key){const svg=$(key+'-chart'),width=Math.max(svg.getBoundingClientRect().width,280),height=250,left=43,right=17,top=14,bottom=43,w=width-left-right,h=height-top-bottom;svg.setAttribute('viewBox',`0 0 ${width} ${height}`);const dates=D.periods.map(p=>Date.parse(p.date)),x=i=>left+(dates[i]-dates[0])/(dates.at(-1)-dates[0])*w;const names=[...new Set(D.periods.flatMap(p=>p.records.map(r=>r.name)))].filter(qualityMatch),max=Math.max(...D.periods.flatMap(p=>p.records.map(r=>r[key]*100)),1)*1.15,y=v=>top+h-v/max*h;let html='';for(let n=0;n<5;n++){const v=max*n/4;html+=`<line x1=\"${left}\" x2=\"${width-right}\" y1=\"${y(v)}\" y2=\"${y(v)}\" stroke=\"#e7eef4\"/><text x=\"${left-7}\" y=\"${y(v)+3}\" text-anchor=\"end\">${v.toFixed(1)}</text>`;}for(let i=0;i<dates.length;i++){const date=D.periods[i].date;html+=`<text x=\"${x(i)}\" y=\"${height-23}\" text-anchor=\"middle\">Q${Math.ceil(Number(date.slice(5,7))/3)}</text>${i===0||date.slice(0,4)!==D.periods[i-1].date.slice(0,4)?`<text class=\"quarter-year\" x=\"${x(i)}\" y=\"${height-7}\" text-anchor=\"middle\">${date.slice(2,4)}</text>`:''}`;}\nfor(const name of names){let path='',started=false;D.periods.forEach((p,i)=>{const r=p.records.find(r=>r.name===name);if(!r){started=false;return;}path+=(started?' L ':' M ')+x(i)+' '+y(r[key]*100);started=true;html+=`<circle cx=\"${x(i)}\" cy=\"${y(r[key]*100)}\" r=\"3.5\" fill=\"${colors[name]}\" stroke=\"white\"/>`;});html+=`<path d=\"${path}\" fill=\"none\" stroke=\"${colors[name]}\" stroke-width=\"2\"/>`;}\nhtml+=`<line class=\"guide\" x1=\"${x(index)}\" x2=\"${x(index)}\" y1=\"${top}\" y2=\"${top+h}\" stroke=\"#9aadc0\" stroke-dasharray=\"3 4\"/>`;for(let i=0;i<dates.length;i++){const from=i===0?left:(x(i-1)+x(i))/2,to=i===dates.length-1?width-right:(x(i)+x(i+1))/2;html+=`<rect class=\"hit\" data-index=\"${i}\" x=\"${from}\" y=\"${top}\" width=\"${to-from}\" height=\"${h}\" fill=\"transparent\" tabindex=\"0\" role=\"button\" aria-label=\"${D.periods[i].date}全部披露资产指标\"/>`;}svg.innerHTML=html;$(key+'-legend').innerHTML=names.map(name=>`<span style=\"--color:${colors[name]}\"><i class=\"dot\"></i>${name}</span>`).join('');}\nfunction guide(i){document.querySelectorAll('svg').forEach(svg=>{const l=svg.querySelector('.guide');if(!l)return;const dates=D.periods.map(p=>Date.parse(p.date)),x=43+(dates[i]-dates[0])/(dates.at(-1)-dates[0])*(svg.viewBox.baseVal.width-60);l.setAttribute('x1',x);l.setAttribute('x2',x);});}\nfunction hide(){$('tooltip').hidden=true;guide(index);}function show(hit){const i=+hit.dataset.index,p=D.periods[i],t=$('tooltip');t.innerHTML=`<b>${p.date} · 对外披露口径</b><table><thead><tr><th>资产</th><th>逾期率</th><th>不良率</th><th>年化不良率</th></tr></thead><tbody>${p.records.map(r=>`<tr><td>${r.name}</td><td>${fmt(r.overdue)}</td><td>${fmt(r.bad)}</td><td>${fmt(r.annualBad)}</td></tr>`).join('')}</tbody></table><div class=\"tipnote\">各资产观察账龄／均值范围不同，见本期统计口径。</div>`;t.hidden=false;guide(i);const rect=hit.getBoundingClientRect(),box=t.getBoundingClientRect();let top=rect.top-box.height-10;if(top<10)top=rect.bottom+10;t.style.left=Math.max(10,Math.min(rect.left+rect.width/2-box.width/2,innerWidth-box.width-10))+'px';t.style.top=Math.max(10,Math.min(top,innerHeight-box.height-10))+'px';}\n$('period').innerHTML=D.periods.map((p,i)=>`<option value=\"${i}\" ${i===index?'selected':''}>${p.date}</option>`).reverse().join('');$('period').addEventListener('change',e=>{index=+e.target.value;render();});document.addEventListener('pointerover',e=>{const hit=e.target.closest('.hit');if(hit)show(hit);});document.querySelectorAll('svg').forEach(svg=>svg.addEventListener('pointerleave',e=>{if(e.pointerType!=='touch')hide();}));document.addEventListener('focusin',e=>{const hit=e.target.closest('.hit');if(hit)show(hit);});document.addEventListener('click',e=>{const hit=e.target.closest('.hit');if(hit)show(hit);else hide();});document.addEventListener('keydown',e=>{if(e.key==='Escape')hide();});window.addEventListener('scroll',hide,{passive:true});let timer;window.addEventListener('resize',()=>{clearTimeout(timer);timer=setTimeout(render,100);});$('source').textContent='来源：JoySpace「'+D.sheet+'」右侧对外披露表 · 读取日期 '+D.retrievedAt+'';render();\n</script><script>window.setQualityControls=function(periodIndex,assetName){index=periodIndex;qualityAsset=assetName;$('period').value=String(index);render();};</script></body></html>\n"
