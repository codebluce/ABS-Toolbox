l\": \"N11\"}, {\"value\": 0.0152, \"display\": \"1.52%\", \"cell\": \"O11\"}, {\"value\": 0.015, \"display\": \"1.50%\", \"cell\": \"P11\"}, {\"value\": 0.0187, \"display\": \"1.87%\", \"cell\": \"Q11\"}, {\"value\": 0.0197, \"display\": \"1.97%\", \"cell\": \"R11\"}], \"bad\": [{\"value\": 0.0035, \"display\": \"0.35%\", \"cell\": \"J12\"}, {\"value\": 0.0047, \"display\": \"0.47%\", \"cell\": \"K12\"}, {\"value\": 0.0067, \"display\": \"0.67%\", \"cell\": \"L12\"}, {\"value\": 0.0066, \"display\": \"0.66%\", \"cell\": \"M12\"}, {\"value\": 0.0049, \"display\": \"0.49%\", \"cell\": \"N12\"}, {\"value\": 0.0041, \"display\": \"0.41%\", \"cell\": \"O12\"}, {\"value\": 0.0052, \"display\": \"0.52%\", \"cell\": \"P12\"}, {\"value\": 0.0064, \"display\": \"0.64%\", \"cell\": \"Q12\"}, {\"value\": 0.007, \"display\": \"0.70%\", \"cell\": \"R12\"}]}}, {\"name\": \"现金贷\", \"metrics\": {\"balance\": [{\"value\": 2023.23, \"display\": \"2023.23\", \"cell\": \"J13\"}, {\"value\": 2159.19, \"display\": \"2159.19\", \"cell\": \"K13\"}, {\"value\": 2228.41, \"display\": \"2228.41\", \"cell\": \"L13\"}, {\"value\": 2393.65, \"display\": \"2393.65\", \"cell\": \"M13\"}, {\"value\": 2849.89, \"display\": \"2849.89\", \"cell\": \"N13\"}, {\"value\": 3055.53, \"display\": \"3055.53\", \"cell\": \"O13\"}, {\"value\": 3686.51, \"display\": \"3686.51\", \"cell\": \"P13\"}, {\"value\": 3816.6, \"display\": \"3816.60\", \"cell\": \"Q13\"}, {\"value\": 4215.0, \"display\": \"4215.00\", \"cell\": \"R13\"}], \"overdue\": [{\"value\": 0.0113872940792693, \"display\": \"1.14%\", \"cell\": \"J14\"}, {\"value\": 0.012273057489151, \"display\": \"1.23%\", \"cell\": \"K14\"}, {\"value\": 0.0148743153189943, \"display\": \"1.49%\", \"cell\": \"L14\"}, {\"value\": 0.0132523384788921, \"display\": \"1.33%\", \"cell\": \"M14\"}, {\"value\": 0.013492553045907, \"display\": \"1.35%\", \"cell\": \"N14\"}, {\"value\": 0.0111971585944173, \"display\": \"1.12%\", \"cell\": \"O14\"}, {\"value\": 0.0121794632321627, \"display\": \"1.22%\", \"cell\": \"P14\"}, {\"value\": 0.0168030346381596, \"display\": \"1.68%\", \"cell\": \"Q14\"}, {\"value\": 0.0137308422301305, \"display\": \"1.37%\", \"cell\": \"R14\"}], \"bad\": [{\"value\": 0.00511768063937367, \"display\": \"0.51%\", \"cell\": \"J15\"}, {\"value\": 0.0047, \"display\": \"0.47%\", \"cell\": \"K15\"}, {\"value\": 0.00571128293267397, \"display\": \"0.57%\", \"cell\": \"L15\"}, {\"value\": 0.00590321510357793, \"display\": \"0.59%\", \"cell\": \"M15\"}, {\"value\": 0.00437531090255122, \"display\": \"0.44%\", \"cell\": \"N15\"}, {\"value\": 0.00366490854287145, \"display\": \"0.37%\", \"cell\": \"O15\"}, {\"value\": 0.00451623351082731, \"display\": \"0.45%\", \"cell\": \"P15\"}, {\"value\": 0.00614132290520359, \"display\": \"0.61%\", \"cell\": \"Q15\"}, {\"value\": 0.00612218268090154, \"display\": \"0.61%\", \"cell\": \"R15\"}]}}], \"source\": \"https://joyspace.jd.com/sheets/6DsPlXNgFeEBf7G2ghLx\", \"sheet\": \"动态池数据（可对外披露）\", \"range\": \"C2:R19\", \"retrievedAt\": \"2026-11-05\", \"notes\": [\"动态池逾期率：时点0-90资产余额/时点核销后全量资产余额\", \"动态池不良率：时点90+资产余额/时点核销后全量资产余额；\", \"动态池余额：京东商城体系内余额；如白条均为场内交易，不包含分分卡、超白等资产；金条不包含拍拍等扩容及场外资产\"]}</script><script>\n'use strict';const DATA=JSON.parse(document.getElementById('pool-data').textContent);const colors={'白条':'#285f9e','金条':'#1a8b8a','白取':'#bd8241','现金贷':'#7a6ba9'};let selected=DATA.periods.length-1,asset='all';const $=id=>document.getElementById(id);const esc=s=>String(s).replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));const num=n=>n.toLocaleString('en-US',{maximumFractionDigits:0});const fmt=(v,k)=>v===null?'—':k==='balance'?num(v.value):(v.value*100).toFixed(2)+'%';\nfunction delta(a,k){const now=a.metrics[k][selected];if(!now)return '—';let prev=selected-1;while(prev>=0&&!a.metrics[k][prev])prev--;if(prev<0)return '无前期数据';const before=a.metrics[k][prev].value;if(k==='balance'){if(!before)return now.value?'新增':'—';const v=(now.value/before-1)*100;return (v>0?'+':'')+v.toFixed(1)+'%';}const v=(now.value-before)*100;return (v>0?'+':'')+v.toFixed(2)+' 个百分点';}\nfunction render(){hideTooltip();const visible=DATA.assets.filter(a=>asset==='all'||a.name===asset);$('cards').innerHTML=visible.map(a=>`<div class=\"card\" style=\"--color:${colors[a.name]}\"><div class=\"card-name\">${a.name}${a.name==='现金贷'?'<span class=\"aggregate\">金条＋白取</span>':''}</div><div class=\"rates\"><div><div class=\"metric-label\">核销后逾期率</div><div class=\"rate\">${fmt(a.metrics.overdue[selected],'overdue')}</div><div class=\"change\">${delta(a,'overdue')}</div></div><div><div class=\"metric-label\">核销后不良率</div><div class=\"rate\">${fmt(a.metrics.bad[selected],'bad')}</div><div class=\"change\">${delta(a,'bad')}</div></div></div></div>`).join('');for(const key of ['balance','overdue','bad'])draw(key,visible);}\nfunction draw(key,visible){const svg=$(key+'-chart'),width=Math.max(svg.getBoundingClientRect().width,280),height=245,left=48,right=18,top=12,bottom=44,w=width-left-right,h=height-top-bottom;svg.setAttribute('viewBox',`0 0 ${width} ${height}`);const dates=DATA.periods.map(p=>Date.parse(p.date)),start=dates[0],end=dates.at(-1),x=i=>left+(dates[i]-start)/(end-start)*w;const values=visible.flatMap(a=>a.metrics[key].map(v=>v===null?null:v.value*(key==='balance'?1:100))).filter(v=>v!==null);const max=Math.max(...values,1)*1.12,y=v=>top+h-v/max*h;let html='',hits='';for(let n=0;n<=4;n++){const val=max*n/4,yy=y(val);html+=`<line x1=\"${left}\" x2=\"${width-right}\" y1=\"${yy}\" y2=\"${yy}\" stroke=\"#e8eef4\"/><text x=\"${left-7}\" y=\"${yy+3}\" text-anchor=\"end\">${key==='balance'?Math.round(val).toLocaleString('en-US'):val.toFixed(1)}</text>`;}for(let i=0;i<dates.length;i++){const date=DATA.periods[i].date,q='Q'+Math.ceil(Number(date.slice(5,7))/3),newYear=i===0||date.slice(0,4)!==DATA.periods[i-1].date.slice(0,4);html+=`<line x1=\"${x(i)}\" x2=\"${x(i)}\" y1=\"${top+h}\" y2=\"${top+h+4}\" stroke=\"#becbd8\"/><text class=\"axis-quarter\" x=\"${x(i)}\" y=\"${height-23}\" text-anchor=\"middle\">${q}</text>${newYear?`<text class=\"axis-year\" x=\"${x(i)}\" y=\"${height-7}\" text-anchor=\"middle\">${date.slice(2,4)}</text>`:''}`;}html+=`<line class=\"time-guide\" x1=\"${x(selected)}\" x2=\"${x(selected)}\" y1=\"${top}\" y2=\"${top+h}\" stroke=\"#a8b7c7\" stroke-dasharray=\"3 4\"/>`;for(const a of visible){let path='',started=false;for(let i=0;i<dates.length;i++){const v=a.metrics[key][i];if(v===null){started=false;continue;}const yy=y(v.value*(key==='balance'?1:100));path+=(started?' L ':' M ')+x(i)+' '+yy;started=true;}html+=`<path d=\"${path}\" fill=\"none\" stroke=\"${colors[a.name]}\" stroke-width=\"2.2\" ${a.name==='现金贷'?'stroke-dasharray=\"6 3\"':''}/>`;for(let i=0;i<dates.length;i++){const v=a.metrics[key][i];if(!v)continue;html+=`<circle cx=\"${x(i)}\" cy=\"${y(v.value*(key==='balance'?1:100))}\" r=\"${i===selected?4.5:3}\" fill=\"${colors[a.name]}\" stroke=\"white\" stroke-width=\"1\"></circle>`;}}for(let i=0;i<dates.length;i++){const from=i===0?left:(x(i-1)+x(i))/2,to=i===dates.length-1?width-right:(x(i)+x(i+1))/2;hits+=`<rect class=\"time-hit\" data-time-index=\"${i}\" x=\"${from}\" y=\"${top}\" width=\"${to-from}\" height=\"${h}\" fill=\"transparent\" tabindex=\"0\" role=\"button\" aria-label=\"${DATA.periods[i].date.slice(0,7)} 全部资产余额、核销后逾期率和不良率\"/>`;}svg.innerHTML=html+hits;$(key+'-legend').innerHTML=visible.map(a=>`<button class=\"legend-item\" data-asset=\"${a.name}\" style=\"--color:${colors[a.name]}\"><span class=\"dot\"></span>${a.name} <b>${fmt(a.metrics[key][selected],key)}</b></button>`).join('');}\nfunction updateGuide(i){\n const dates=DATA.periods.map(p=>Date.parse(p.date)),fraction=(dates[i]-dates[0])/(dates.at(-1)-dates[0]);\n document.querySelectorAll('.chart').forEach(svg=>{const width=svg.viewBox.baseVal.width,line=svg.querySelector('.time-guide'),x=48+fraction*(width-66);if(!line)return;line.setAttribute('x1',x);line.setAttribute('x2',x);});\n}\nfunction hideTooltip(){const tooltip=$('chart-tooltip');if(tooltip)tooltip.hidden=true;updateGuide(selected);}\nfunction showTooltip(column){\n const i=+column.dataset.timeIndex,tooltip=$('chart-tooltip');\n tooltip.innerHTML=`<div class=\"tooltip-head\">${DATA.periods[i].date.slice(0,7)} · 全部资产</div><table class=\"tooltip-table\"><thead><tr><th>资产</th><th>余额</th><th>逾期率</th><th>不良率</th></tr></thead><tbody>${DATA.assets.map(a=>`<tr><td><span class=\"dot\" style=\"--color:${colors[a.name]}\"></span>${a.name}</td><td>${fmt(a.metrics.balance[i],'balance')}</td><td>${fmt(a.metrics.overdue[i],'overdue')}</td><td>${fmt(a.metrics.bad[i],'bad')}</td></tr>`).join('')}</tbody></table><div class=\"tooltip-foot\">余额：原表数值 · 逾期率、不良率：核销后<br>现金贷＝金条＋白取</div>`;\n tooltip.hidden=false;updateGuide(i);\n const rect=column.getBoundingClientRect(),box=tooltip.getBoundingClientRect();\n let left=rect.left+rect.width/2-box.width/2,top=rect.top-box.height-10;\n if(top<10)top=rect.bottom+10;\n tooltip.style.left=Math.max(10,Math.min(left,innerWidth-box.width-10))+'px';\n tooltip.style.top=Math.max(10,Math.min(top,innerHeight-box.height-10))+'px';\n}\ndocument.addEventListener('pointerover',e=>{const column=e.target.closest('.time-hit');if(column)showTooltip(column);});\ndocument.querySelectorAll('.chart').forEach(svg=>svg.addEventListener('pointerleave',e=>{if(e.pointerType!=='touch')hideTooltip();}));\ndocument.addEventListener('focusin',e=>{const column=e.target.closest('.time-hit');if(column)showTooltip(column);});\ndocument.addEventListener('focusout',e=>{if(e.target.closest('.time-hit'))hideTooltip();});\ndocument.addEventListener('click',e=>{const column=e.target.closest('.time-hit');if(column)showTooltip(column);else hideTooltip();});\ndocument.addEventListener('keydown',e=>{if(e.key==='Escape')hideTooltip();});\nwindow.addEventListener('scroll',hideTooltip,{passive:true});\n$('period').innerHTML=[...DATA.periods].map((p,i)=>`<option value=\"${i}\" ${i===selected?'selected':''}>${p.date.slice(0,7